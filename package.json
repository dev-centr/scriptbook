{
  "name": "scriptbook-diagrams",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "diagrams:generate": "node scripts/generate-diagrams.mjs",
